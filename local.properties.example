# Signing properties for release builds
# Copy these to your local.properties file and fill in the values
# DO NOT commit local.properties to version control

KEYSTORE_PATH=/path/to/your/release-keystore.jks
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=your_key_alias
KEY_PASSWORD=your_key_password

# API Keys
MAPS_API_KEY=your_google_maps_api_key_here
AI_KEY=your_gemini_api_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Custom Backend URL (Optional)
# BASE_URL="https://your-custom-url.com/"
